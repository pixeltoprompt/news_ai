# Copy this file to .env and fill in keys to enable live LLM generation
# and real embeddings. If none are set, the app runs fully offline:
#   - Embeddings fall back to a locally-fitted TF-IDF vectorizer
#   - Generation falls back to a deterministic extractive summarizer
# The RAG architecture, hybrid retrieval, and ingestion pipeline behave
# identically either way — only generation/embedding quality changes.

ANTHROPIC_API_KEY=
OPENAI_API_KEY=
COHERE_API_KEY=
